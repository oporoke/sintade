# Two files on the host, both mode 0600, written by the deploy job from GitHub environment
# secrets (docs/design.md §19). Values below are placeholders; never commit real ones.

# ---- /opt/sintade/.env  (read by `docker compose`) ------------------------------------------
DOMAIN=app.example.tz              # TODO: Verify: the production domain is not decided
ACME_EMAIL=ops@example.tz
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-too-at-least-8-chars
BACKUP_DIR=/var/backups/sintade
# The same bucket and service account the app uses (see /etc/sintade/env below).
S3_BUCKET=sintade-prod
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-too-at-least-8-chars
# IMAGE_TAG is set by the deploy script (the git SHA).
# Local testing with a self-signed certificate:  CADDY_TLS="tls internal"  HTTPS_PORT=8443  HTTP_PORT=8088

# ---- /etc/sintade/env  (read by the api and worker containers) ----------------------------------
DATABASE_URL=postgres://app:change-me@postgres:5432/sintade
PUBLIC_BASE_URL=https://app.example.tz
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.app.example.tz
S3_BUCKET=sintade-prod
S3_ACCESS_KEY=change-me             # a MinIO service account for the bucket, not the root user
S3_SECRET_KEY=change-me-too-at-least-8-chars
SMTP_URL=smtps://user:pass@smtp.example.tz:465   # TODO: Verify: the mail provider is not chosen
SESSION_SECRET=64-random-bytes-base64            # openssl rand -base64 64 | tr -d '\n'
RUST_LOG=info
APP_ENV=production
SENTRY_DSN=                         # empty: no error reporting
ALERT_EMAIL=ops@example.tz          # watchdog alerts (stuck queue, dead jobs, failing backups)
WORKER_SCRATCH_DIR=/var/lib/sintade/scratch
WORKER_CONCURRENCY=2
WORKER_PROCESS_TAKE_CONCURRENCY=1
# RATE_LIMIT_SCALE must stay unset (= 1) in production.
