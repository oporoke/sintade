  "query": "\n        SELECT t.recording_id, t.mime_type, t.finalized_at IS NOT NULL AS \"finalized!\"\n        FROM takes t\n        JOIN recordings r ON r.id = t.recording_id AND r.workspace_id = t.workspace_id\n        WHERE t.id = $1 AND t.workspace_id = $2 AND r.owner_id = $3\n        ",
