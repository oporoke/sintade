{
  "db_name": "PostgreSQL",
  "query": "\n            UPDATE jobs\n            SET locked_by = $1, locked_until = now() + make_interval(secs => $2)\n            WHERE id = (\n                SELECT id FROM jobs\n                WHERE done_at IS NULL\n                  AND dead_at IS NULL\n                  AND run_at <= now()\n                  AND (locked_until IS NULL OR locked_until < now())\n                ORDER BY run_at\n                FOR UPDATE SKIP LOCKED\n                LIMIT 1\n            )\n            RETURNING id, kind, payload, attempts, max_attempts\n            ",
