  "query": "\n        SELECT id, workspace_id, recording_id, slug, visibility::text AS \"visibility!\",\n               allow_download, expires_at, revoked_at, created_at\n        FROM share_links\n        WHERE workspace_id = $1 AND recording_id = $2\n        ORDER BY created_at DESC, id DESC\n        ",
