# Postgres runs natively on this machine (not via compose.yml) — see docs/adr/0001-native-postgres-for-local-dev.md.
# Point this at your own local Postgres 16+ instance and database.
DATABASE_URL=postgres://app:app@localhost:5433/sintade

S3_ENDPOINT=http://localhost:9010
S3_BUCKET=sintade-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret

PUBLIC_BASE_URL=http://localhost:4200

SESSION_SECRET=replace-with-64-random-bytes-base64
DATA_ENC_KEY=replace-with-32-random-bytes-base64

SMTP_URL=smtp://localhost:1025

FFMPEG_PATH=ffmpeg
WORKER_CONCURRENCY=2

RUST_LOG=info,api=debug,worker=debug
