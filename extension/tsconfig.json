{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@capture": ["./../web/src/app/capture/index.ts"],
      "@capture/*": ["./../web/src/app/capture/*"]
    }
  },
  "include": ["src", "scripts", "e2e", "*.ts", "*.mjs"]
}
