DATABASE_URL=postgres://app:app@localhost:5432/sintade

S3_ENDPOINT=http://localhost:9010
# Where browsers PUT chunks (ADR-0010): the HTTPS dev server, which proxies /<bucket> to MinIO.
S3_PUBLIC_ENDPOINT=https://localhost:4200
S3_BUCKET=sintade-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret

PUBLIC_BASE_URL=https://localhost:4200

SESSION_SECRET=replace-with-64-random-bytes-base64
DATA_ENC_KEY=replace-with-32-random-bytes-base64

SMTP_URL=smtp://localhost:1025

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=2
# Of those, how many may be ProcessTake at once (FFmpeg uses every core).
WORKER_PROCESS_TAKE_CONCURRENCY=1
# Local disk for media processing (one directory per job, removed afterwards). Default: the OS
# temp dir's sintade-scratch. Needs room for a take's source plus its MP4 (~2x the upload).
WORKER_SCRATCH_DIR=

RUST_LOG=info,api=debug,worker=debug
