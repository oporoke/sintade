{
  "openapi": "3.1.0",
  "info": {
    "title": "Sintade API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Logged in; sets session, refresh and CSRF cookies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Login rate limit hit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Idempotent and keyed off the refresh cookie (see `IdentityService::logout`): logging out with\nno cookie, an already-revoked cookie, or a garbage cookie all just clear client cookies and\nreturn `204`, matching the anti-enumeration style used elsewhere in this module. Also acts on\nan ambient cookie, so it needs the CSRF double-submit check too.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Session revoked (idempotent); cookies cleared"
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "\"Log out everywhere\": revokes every refresh session for the caller and clears this\nbrowser's cookies. Needs a live session (it acts on the user, not one refresh token) and\nthe CSRF check. Other devices' access cookies lapse within `ACCESS_TOKEN_TTL` (15 min).",
        "operationId": "logout_all",
        "responses": {
          "204": {
            "description": "Every session revoked; cookies cleared"
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Always `202` with the same message, whether or not the email exists (US-03) -- the identity\nservice already enforces this at the service layer, this handler just can't turn it into a\nnon-generic error either.",
        "operationId": "forgot_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Same response whether or not the email exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "reset_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed; all sessions revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired reset token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Password too weak",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Keys off the refresh cookie, not `SessionClaims` -- a still-valid refresh token should be\nusable to get a new access cookie even after the old access cookie has already expired,\nwhich is the whole point of having a separate, longer-lived refresh token (US-02). Acts\npurely on an ambient cookie, so it's one of the two routes that need the CSRF double-submit\ncheck (see `crate::csrf`).",
        "operationId": "refresh",
        "responses": {
          "200": {
            "description": "Rotated; sets new session, refresh and CSRF cookies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or reused refresh token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Accepted; a verification email is sent if the details are valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid email, password or display name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Signup rate limit hit",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "verify_email",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Email verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired verification token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Composes the user (from `identity`) with their memberships (from `tenancy`). `Session`\naccess, not `Workspace`: it lists the caller's own memberships, not one workspace's data.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The current user and their workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "me"
        ],
        "summary": "Profile settings. Acts on the ambient session cookie, so it takes the CSRF double-submit\ncheck like `/auth/refresh` and `/auth/logout`.",
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeUser"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid display name",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings": {
      "post": {
        "tags": [
          "recordings"
        ],
        "summary": "Starts a recording: creates the recording and its first take in the caller's current\nworkspace (upload protocol v1, docs/design.md §9). Chunks are presigned and acked against\nthe returned `take_id`.",
        "operationId": "create_recording",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRecordingBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Recording and take created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRecordingResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "402": {
            "description": "The plan's recording limit is reached (free tier: 50)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing CSRF token, or the role can't create recordings",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not a member of the session's workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid title or MIME type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recordings/{recording_id}/retry": {
      "post": {
        "tags": [
          "recordings"
        ],
        "summary": "Reprocesses a recording whose processing failed (`failed → processing`, docs/design.md §4).\nThe work runs in the background; poll the recording for `ready` or `failed` again.",
        "operationId": "retry_recording",
        "parameters": [
          {
            "name": "recording_id",
            "in": "path",
            "description": "The failed recording",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Processing queued again"
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing CSRF token, or the role can't edit recordings",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such recording in the caller's workspace",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The recording isn't failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/takes/{take_id}/chunks/{idx}/ack": {
      "post": {
        "tags": [
          "takes"
        ],
        "summary": "Confirms chunk `idx` is uploaded, with its size and SHA-256. Idempotent on\n`(take_id, idx)`: the same size and hash again is a no-op; a different one is `409`.",
        "operationId": "ack_chunk",
        "parameters": [
          {
            "name": "take_id",
            "in": "path",
            "description": "The take",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idx",
            "in": "path",
            "description": "Chunk index (0-based)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AckChunkBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Chunk recorded (or already recorded identically)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AckChunkResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such take, or not the caller's",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Acked before with a different hash or size, or the take is finalized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Not uploaded, size differs from storage, or invalid size/hash/index",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/takes/{take_id}/chunks/{idx}/url": {
      "post": {
        "tags": [
          "takes"
        ],
        "summary": "Presigned `PUT` URLs for chunk `idx` (and, with `?count=`, the chunks after it). Only the\nrecording's owner gets them, and only until the take is finalized. The browser then `PUT`s\nthe bytes straight to object storage (media never passes through the API).",
        "operationId": "presign_chunks",
        "parameters": [
          {
            "name": "take_id",
            "in": "path",
            "description": "The take",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "idx",
            "in": "path",
            "description": "First chunk index (0-based)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "count",
            "in": "path",
            "description": "How many consecutive chunk URLs to return, starting at `idx` (1–10, default 1). Used to\nbatch round trips after a reconnect.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload URLs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresignChunksResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such take, or not the caller's",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "The take is already finalized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "count outside 1–10 or index too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/takes/{take_id}/finalize": {
      "post": {
        "tags": [
          "takes"
        ],
        "summary": "Declares the take complete. When every chunk `0..chunk_count` is acknowledged the take is\nfinalized, the recording moves to `processing` and `TakeFinalized` is emitted; otherwise\n`422` lists the missing indexes. Retrying a successful finalize is `202` again.",
        "operationId": "finalize_take",
        "parameters": [
          {
            "name": "take_id",
            "in": "path",
            "description": "The take",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinalizeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Finalized; processing starts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalizeResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "402": {
            "description": "Longer than the plan allows (free tier: 10 minutes)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing or mismatched CSRF token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such take, or not the caller's",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Finalized before with another count, or the recording no longer accepts uploads",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Chunks missing (listed in `missing`), extra chunks, or invalid count/duration",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/MissingChunksProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/takes/{take_id}/status": {
      "get": {
        "tags": [
          "takes"
        ],
        "summary": "Which chunks the server has acknowledged, so an interrupted or recovered upload sends only\nthe missing ones. Owner only.",
        "operationId": "take_status",
        "parameters": [
          {
            "name": "take_id",
            "in": "path",
            "description": "The take",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Upload state of the take",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TakeStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such take, or not the caller's",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Liveness"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Readiness: the database answers"
          },
          "500": {
            "description": "Database unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AckChunkBody": {
        "type": "object",
        "required": [
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the chunk's bytes, 64 hex characters."
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes PUT for this chunk (1 to 16 MiB). Must match the stored object.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "AckChunkResponse": {
        "type": "object",
        "required": [
          "idx",
          "status"
        ],
        "properties": {
          "idx": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/AckStatus"
          }
        }
      },
      "AckStatus": {
        "type": "string",
        "enum": [
          "acked",
          "already_acked"
        ]
      },
      "ChunkUploadUrl": {
        "type": "object",
        "required": [
          "idx",
          "url"
        ],
        "properties": {
          "idx": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "url": {
            "type": "string",
            "description": "Presigned `PUT` for this chunk's bytes. A bearer credential: don't log it."
          }
        }
      },
      "CreateRecordingBody": {
        "type": "object",
        "required": [
          "mime_type",
          "has_system_audio",
          "has_mic",
          "has_camera"
        ],
        "properties": {
          "has_camera": {
            "type": "boolean"
          },
          "has_mic": {
            "type": "boolean"
          },
          "has_system_audio": {
            "type": "boolean"
          },
          "mime_type": {
            "type": "string",
            "description": "The take's MIME type as `MediaRecorder` reports it, e.g. `video/webm;codecs=vp9,opus`.\nThe container must be `video/webm` or `video/mp4`."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional; blank or missing becomes \"Untitled recording\". At most 200 characters."
          }
        },
        "additionalProperties": false
      },
      "CreateRecordingResponse": {
        "type": "object",
        "required": [
          "recording_id",
          "take_id",
          "max_duration_ms"
        ],
        "properties": {
          "max_duration_ms": {
            "type": "integer",
            "format": "int32",
            "description": "The longest take the workspace's plan accepts (pauses excluded). The recorder stops by\nitself before this; finalize rejects anything longer.",
            "minimum": 0
          },
          "recording_id": {
            "type": "string",
            "format": "uuid"
          },
          "take_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FinalizeBody": {
        "type": "object",
        "required": [
          "chunk_count",
          "duration_ms"
        ],
        "properties": {
          "chunk_count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of chunks in the take; indexes `0..chunk_count` must all be acknowledged.",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "format": "int32",
            "description": "The take's length, pauses excluded.",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "FinalizeResponse": {
        "type": "object",
        "required": [
          "recording_id",
          "state"
        ],
        "properties": {
          "recording_id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "$ref": "#/components/schemas/RecordingStateName"
          }
        }
      },
      "ForgotPasswordBody": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "LoginBody": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "user",
          "workspaces",
          "current_workspace_id"
        ],
        "properties": {
          "current_workspace_id": {
            "type": "string",
            "format": "uuid",
            "description": "The workspace the session's access cookie was issued for -- lets the client pick the\nright entry out of `workspaces` as \"current\" without guessing."
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeWorkspace"
            }
          }
        }
      },
      "MeUser": {
        "type": "object",
        "required": [
          "id",
          "email",
          "display_name",
          "email_verified"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "email_verified": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MeWorkspace": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "is_personal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_personal": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MemberRole"
          }
        }
      },
      "MemberRole": {
        "type": "string",
        "description": "Mirrors `kernel::Role` for the OpenAPI schema (kernel stays free of API concerns).",
        "enum": [
          "owner",
          "admin",
          "member",
          "viewer"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "description": "The body of every endpoint that only reports an outcome.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "MissingChunksProblem": {
        "type": "object",
        "description": "The `422` body when chunks are missing: problem details plus the indexes to upload.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "missing",
          "missing_count"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "Missing indexes, ascending; at most 1000 listed."
          },
          "missing_count": {
            "type": "integer",
            "description": "How many are missing in total.",
            "minimum": 0
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "PresignChunksResponse": {
        "type": "object",
        "required": [
          "urls",
          "expires_in_s"
        ],
        "properties": {
          "expires_in_s": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds each URL stays valid.",
            "minimum": 0
          },
          "urls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChunkUploadUrl"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details, the body of every error response.",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "ReceivedChunkBody": {
        "type": "object",
        "required": [
          "idx",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "idx": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "description": "Lowercase hex."
          },
          "size_bytes": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "RecordingStateName": {
        "type": "string",
        "enum": [
          "processing"
        ]
      },
      "RegisterBody": {
        "type": "object",
        "required": [
          "email",
          "password",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ResetPasswordBody": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "TakeStatusResponse": {
        "type": "object",
        "required": [
          "take_id",
          "recording_id",
          "finalized",
          "received",
          "chunks"
        ],
        "properties": {
          "chunks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceivedChunkBody"
            },
            "description": "The acknowledged chunks with the size and SHA-256 recorded for each."
          },
          "finalized": {
            "type": "boolean"
          },
          "received": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "Acknowledged chunk indexes, ascending. Upload the rest."
          },
          "recording_id": {
            "type": "string",
            "format": "uuid"
          },
          "take_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UpdateProfileBody": {
        "type": "object",
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          }
        }
      },
      "VerifyEmailBody": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      }
    }
  }
}
