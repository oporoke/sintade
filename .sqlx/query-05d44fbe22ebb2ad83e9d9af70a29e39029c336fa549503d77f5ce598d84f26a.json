  "query": "\n        SELECT w.id, w.name, w.is_personal, m.role::text as \"role!\"\n        FROM workspaces w\n        JOIN memberships m ON m.workspace_id = w.id\n        WHERE m.user_id = $1\n        ORDER BY w.created_at\n        ",
